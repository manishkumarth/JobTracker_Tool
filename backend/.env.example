PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mail-sender
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# Scheduled email worker (optional)
# Protects GET /api/cron/process-scheduled-emails (required for that endpoint)
CRON_SECRET=
# In-process tick interval in ms (local / long-running servers only)
SCHEDULER_INTERVAL_MS=30000
DISABLE_SCHEDULER=false
# Retry sends interrupted mid-flight (default false = fail safe)
SCHEDULER_RETRY_INTERRUPTED=false

# Cloudinary (for resume storage) - single URL format
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
